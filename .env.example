# Placement Preparation Agent - Environment Variables

# App Config
PROJECT_NAME="Placement Preparation Agent"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-very-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./placement_prep.db"
LOG_LEVEL="INFO"
ENVIRONMENT="development"

# Microsoft Foundry Agent Configuration
FOUNDRY_PROJECT_ENDPOINT=""
FOUNDRY_AGENT_NAME="PlacementPreparationAgent"
FOUNDRY_AGENT_VERSION="4"

# Azure AI Search (Knowledge Retrieval Layer)
AZURE_AI_SEARCH_ENDPOINT=""
AZURE_AI_SEARCH_KEY=""
AZURE_AI_SEARCH_INDEX="placement-prep-knowledge"

# GitHub REST API (Public Repositories)
GITHUB_TOKEN=""

# AI Gateway Settings
AI_CACHE_ENABLED=true
MAX_GITHUB_REPOS=10
MAX_README_CHARS=2000
